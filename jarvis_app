# --- CONFIGURATION DE BASE ---
WAKEWORD_NAME = "hey_jarvis"
SAMPLE_RATE = 16000
CHUNK_SIZE = 1280

# System Prompt clarifié avec limites strictes pour éviter les boucles d'erreur 500
SYSTEM_PROMPT = """Tu es Jarvis, un assistant IA francophone réactif et concis.
Si la demande nécessite une action système ou une recherche, réponds UNIQUEMENT avec un JSON valide :
- Météo : {"action": "get_weather", "target": "NomVille"}
- Recherche Web : {"action": "web_search", "target": "mots clés"}
- Lancer Application : {"action": "open_app", "target": "nom_app"}
- Action Système : {"action": "system_control", "target": "verrouiller/éteindre/annuler"}
Sinon (discussion, salutations), réponds avec une phrase courte et directe en français (max 2 phrases)."""

# --- ANIMATION RÉACTEUR ARC ---
class ArcReactor(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.angle = 0
        self.pulse = 0
        self.pulse_growing = True
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.update_animation)
        self.timer.start(16)

    def update_animation(self):
        self.angle = (self.angle + 2) % 360
        if self.pulse_growing:
            self.pulse += 0.4
            if self.pulse >= 12: self.pulse_growing = False
        else:
            self.pulse -= 0.4
            if self.pulse <= 0: self.pulse_growing = True
        self.update()

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        center = QPointF(self.width() / 2, self.height() / 2)
        radius = min(self.width(), self.height()) / 3

        painter.setPen(QPen(QColor(0, 229, 255, 180), 3))
        painter.drawEllipse(center, radius + self.pulse, radius + self.pulse)

        painter.save()
        painter.translate(center)
        painter.rotate(self.angle)
        painter.setPen(QPen(QColor(0, 255, 204, 220), 2, Qt.PenStyle.DashLine))
        painter.drawEllipse(QPointF(0, 0), radius - 15, radius - 15)
        painter.restore()

        painter.setBrush(QBrush(QColor(0, 229, 255, 110)))
        painter.setPen(Qt.PenStyle.NoPen)
        painter.drawEllipse(center, radius - 35, radius - 35)

# --- WORKER AUDIO & VEILLE (THREAD ARRIÈRE-PLAN) ---
class WakeWordWorker(QThread):
    wakeword_detected = pyqtSignal()
    status_changed = pyqtSignal(str, str)

    def __init__(self):
        super().__init__()
        self.running = True

    def run(self):
        try:
            oww_model = Model(wakeword_models=[WAKEWORD_NAME], inference_framework="onnx")
        except Exception as e:
            self.status_changed.emit(f"Erreur Modèle: {e}", "#ff3333")
            return

        def audio_callback(indata, frames, time, status):
            if not self.running:
                raise sd.CallbackStop
            audio_data = (indata[:, 0] * 32767).astype(np.int16)
            prediction = oww_model.predict(audio_data)
            if prediction[WAKEWORD_NAME] > 0.5:
                oww_model.reset()
                self.wakeword_detected.emit()

        while self.running:
            self.status_changed.emit("VEILLE PASSIVE ('Hey Jarvis')", "#00ffcc")
            with sd.InputStream(samplerate=SAMPLE_RATE, channels=1, callback=audio_callback, blocksize=CHUNK_SIZE):
                while self.running:
                    sd.sleep(100)

    def stop(self):
        self.running = False

# --- INTERFACE PRINCIPALE HUD ---
class JarvisHUD(QMainWindow):
    def __init__(self):
        super().__init__()
        self.initUI()
        
        # Démarrer le Thread d'écoute
        self.worker = WakeWordWorker()
        self.worker.wakeword_detected.connect(self.on_wakeword)
        self.worker.status_changed.connect(self.update_status)
        self.worker.start()

    def initUI(self):
        self.setWindowTitle("J.A.R.V.I.S. - System Control")
        self.resize(950, 620)
        self.setStyleSheet("""
            QMainWindow { background-color: #080b12; }
            QLabel { color: #00e5ff; font-family: 'Consolas', monospace; }
            QTextEdit { background-color: #0d131d; border: 1px solid #00e5ff; border-radius: 5px; color: #a0f0ff; font-family: 'Consolas', monospace; font-size: 13px; }
            QLineEdit { background-color: #0d131d; border: 1px solid #00e5ff; color: #ffffff; padding: 6px; font-family: 'Consolas'; }
            QPushButton { background-color: #00e5ff; color: #080b12; font-weight: bold; padding: 6px 12px; border: none; }
            QPushButton:hover { background-color: #00ffcc; }
        """)

        central = QWidget(self)
        self.setCentralWidget(central)
        layout = QHBoxLayout(central)

        # Panneau Gauche
        left = QVBoxLayout()
        title = QLabel("J.A.R.V.I.S.")
        title.setFont(QFont("Consolas", 22, QFont.Weight.Bold))
        title.setAlignment(Qt.AlignmentFlag.AlignCenter)
        left.addWidget(title)

        self.reactor = ArcReactor(self)
        self.reactor.setMinimumSize(280, 280)
        left.addWidget(self.reactor)

        self.status_label = QLabel("INITIALISATION...")
        self.status_label.setFont(QFont("Consolas", 10))
        self.status_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.update_status("INITIALISATION", "#ffaa00")
        left.addWidget(self.status_label)

        layout.addLayout(left, stretch=1)

        # Panneau Droit
        right = QVBoxLayout()
        right.addWidget(QLabel("CONSOLE & DIALOGUE"))

        self.log_box = QTextEdit()
        self.log_box.setReadOnly(True)
        self.log_box.append("[SYSTEM] Interface initialisée.")
        right.addWidget(self.log_box)

        # Zone d'entrée manuelle / commande
        input_layout = QHBoxLayout()
        self.cmd_input = QLineEdit()
        self.cmd_input.setPlaceholderText("Entrez une commande...")
        self.cmd_input.returnPressed.connect(self.send_command)
        
        btn = QPushButton("Envoyer")
        btn.clicked.connect(self.send_command)

        input_layout.addWidget(self.cmd_input)
        input_layout.addWidget(btn)
        right.addLayout(input_layout)

        layout.addLayout(right, stretch=2)

    def update_status(self, text, color="#00e5ff"):
        self.status_label.setText(f"STATUT : {text}")
        self.status_label.setStyleSheet(f"color: {color}; border: 1px solid {color}; padding: 6px; border-radius: 4px;")

    def add_log(self, sender, message):
        self.log_box.append(f"[{sender}] {message}")

    def speak(self, text):
        """Synthèse vocale 100% hors-ligne via pyttsx3 (SAPI5 Windows)."""
        def _speak_thread():
            try:
                
                engine = pyttsx3.init()
                engine.setProperty('rate', 180)
                
                # Sélection de la voix française Windows si présente
                voices = engine.getProperty('voices')
                for voice in voices:
                    if "french" in voice.name.lower() or "fr" in voice.id.lower():
                        engine.setProperty('voice', voice.id)
                        break
                        
                engine.say(text)
                engine.runAndWait()
            except Exception as e:
                print(f"[Erreur Synthèse Vocale pyttsx3] : {e}")

        threading.Thread(target=_speak_thread, daemon=True).start()

    def on_wakeword(self):
        self.update_status("EN ÉCOUTE...", "#00e5ff")
        self.add_log("SYSTEM", "Mot-clé 'Hey Jarvis' détecté.")
        self.speak("Oui ? Je vous écoute.")

    def send_command(self):
        query = self.cmd_input.text().strip()
        if not query: return
        
        self.cmd_input.clear()
        self.add_log("VOUS", query)
        self.update_status("TRAITEMENT...", "#ffaa00")

        # Traitement LLM
        QTimer.singleShot(100, lambda: self.process_llm(query))

    def process_llm(self, query):
        try:
            # Traitement direct des salutations simples pour éviter tout bug LLM
            clean_query = query.strip().lower()
            if clean_query in ["bonjour", "salut", "hello", "coucou", "hey"]:
                output_text = "Bonjour ! Comment puis-je vous aider aujourd'hui ?"
                self.add_log("JARVIS", output_text)
                self.speak(output_text)
                self.update_status("VEILLE PASSIVE ('Hey Jarvis')", "#00ffcc")
                return

            # Appel Ollama sécurisé avec options anti-boucle
            res = ollama.chat(
                model='llama3.2', 
                messages=[
                    {'role': 'system', 'content': SYSTEM_PROMPT},
                    {'role': 'user', 'content': query}
                ],
                options={
                    'temperature': 0.3,
                    'repeat_penalty': 1.2,
                    'num_predict': 100,  # Limite le nombre maximum de mots générés
                    'stop': ['\n', 'VOUS:', 'JARVIS:', '[ERREUR]']
                }
            )['message']['content'].strip()

            output_text = ""
            if res.startswith("{") and res.endswith("}"):
                cmd = json.loads(res)
                act, target = cmd.get("action"), cmd.get("target")

                if act == "open_app": output_text = actions.open_application(target)
                elif act == "system_control": output_text = actions.system_control(target)
                elif act == "get_weather": output_text = actions.get_weather(target)
                elif act == "web_search": output_text = actions.web_search(target)
            else:
                output_text = res

            self.add_log("JARVIS", output_text)
            self.speak(output_text)

        except Exception as e:
            self.add_log("ERREUR", str(e))
        
        self.update_status("VEILLE PASSIVE ('Hey Jarvis')", "#00ffcc")
        try:
            res = ollama.chat(
                model='llama3.2', 
                messages=[
                    {'role': 'system', 'content': SYSTEM_PROMPT},
                    {'role': 'user', 'content': query}
                ],
                options={
                    'temperature': 0.7,
                    'stop': ['\n\n', 'VOUS:', 'JARVIS:']  # Arrête la génération avant les boucles
                }
            )['message']['content'].strip()

            output_text = ""
            if res.startswith("{") and res.endswith("}"):
                cmd = json.loads(res)
                act, target = cmd.get("action"), cmd.get("target")

                if act == "open_app": output_text = actions.open_application(target)
                elif act == "system_control": output_text = actions.system_control(target)
                elif act == "get_weather": output_text = actions.get_weather(target)
                elif act == "web_search": output_text = actions.web_search(target)
            else:
                output_text = res

            self.add_log("JARVIS", output_text)
            self.speak(output_text)

        except Exception as e:
            self.add_log("ERREUR", str(e))
        
        self.update_status("VEILLE PASSIVE ('Hey Jarvis')", "#00ffcc")

    def closeEvent(self, event):
        self.worker.stop()
        self.worker.wait()
        event.accept()

